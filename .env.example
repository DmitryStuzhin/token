# Runtime
NODE_ENV=development
PORT=3000

# Production uses PostgreSQL. SQLite remains only for local rollback/tests.
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://token:change-me@127.0.0.1:55432/token
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_MIGRATE_ON_START=true
WRITE_FREEZE=false

# Docker Compose PostgreSQL. Keep these values consistent with DATABASE_URL.
POSTGRES_DB=token
POSTGRES_USER=token
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432

# Source/rollback SQLite file and input for db:migrate-from-sqlite.
TOKEN_DB=data/token.db

# Set to true only when the application is served over HTTPS.
COOKIE_SECURE=false

# debug | info | warn | error | silent
LOG_LEVEL=info

# Diagnostic only: count executed SQLite statements for baseline scripts.
SQL_METRICS=false

# Transactional email. Required in production; left empty locally letters are
# only logged. SMTP_USER must equal the address inside EMAIL_FROM — providers
# reject a mismatched envelope sender. Check with `npm run mail:check`.
PUBLIC_ORIGIN=https://tokenapp.ru
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=token@example.com
SMTP_PASSWORD=replace-with-an-app-password
EMAIL_FROM=Token <token@example.com>
