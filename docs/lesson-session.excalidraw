  {
   "id": "e62-953284",
   "type": "text",
   "x": 1193.0,
   "y": 1159.0,
   "width": 321.75,
   "height": 113.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 354520302,
   "version": 1,
   "versionNonce": 1922387982,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1754500000000,
   "link": null,
   "locked": false,
   "text": "Вариант A остаётся, но:\n\n· нужен долгоживущий процесс с WebSocket —\n   значит VPS, а не serverless-хостинг\n· снапшот кода в одну сторону (ученик →\n   репетитор), без совместного редактирования\n· CRDT (Yjs) — только если оба будут править",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Вариант A остаётся, но:\n\n· нужен долгоживущий процесс с WebSocket —\n   значит VPS, а не serverless-хостинг\n· снапшот кода в одну сторону (ученик →\n   репетитор), без совместного редактирования\n· CRDT (Yjs) — только если оба будут править",
   "lineHeight": 1.25,
   "autoResize": true
  }
