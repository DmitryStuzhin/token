APP_DOMAIN=tokenapp.ru
ACME_EMAIL=admin@example.com

POSTGRES_DB=token
POSTGRES_USER=token
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql://token:replace-with-a-long-random-secret@postgres:5432/token

DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
LOG_LEVEL=info
