APP_DOMAIN=tokenapp.ru
ACME_EMAIL=admin@example.com

POSTGRES_DB=token
POSTGRES_USER=token
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql://token:replace-with-a-long-random-secret@postgres:5432/token

DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
LOG_LEVEL=info
# PUBLIC_ORIGIN не задаётся здесь: production.yml выводит его из APP_DOMAIN.

# Transactional email. SMTP_USER must equal the address inside EMAIL_FROM:
# the provider rejects a mismatched envelope sender. Verify with `npm run mail:check`.
# Timeweb: smtp.timeweb.ru, 465 with SMTP_SECURE=true, or 587 with SMTP_SECURE=false.
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@tokenapp.ru
SMTP_PASSWORD=replace-with-the-mailbox-password
EMAIL_FROM=Token <noreply@tokenapp.ru>
